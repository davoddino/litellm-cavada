datasource client {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-py"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

// Budget / Rate Limits for an org
model LiteLLM_BudgetTable {
  budget_id String @id @default(uuid())
  max_budget Float?
  soft_budget Float?
  max_parallel_requests Int?
  tpm_limit     BigInt?
  rpm_limit     BigInt?
  model_max_budget Json?
  budget_duration String?
  budget_reset_at DateTime?
  allowed_models String[] @default([]) // per-member model scope; empty = inherit team models
  created_at    DateTime               @default(now()) @map("created_at")
  created_by String
  updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
  updated_by String
  organization LiteLLM_OrganizationTable[] // multiple orgs can have the same budget
  projects LiteLLM_ProjectTable[] // multiple projects can have the same budget
  keys LiteLLM_VerificationToken[] // multiple keys can have the same budget
  end_users LiteLLM_EndUserTable[] // multiple end-users can have the same budget
  tags LiteLLM_TagTable[] // multiple tags can have the same budget
  team_membership LiteLLM_TeamMembership[] // budgets of Users within a Team 
  organization_membership LiteLLM_OrganizationMembership[] // budgets of Users within a Organization 
}

// Models on proxy
model LiteLLM_CredentialsTable {
  credential_id String @id @default(uuid())
  credential_name String @unique
  credential_values Json
  credential_info Json? 
  created_at    DateTime               @default(now()) @map("created_at")
  created_by String
  updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
  updated_by String
}

// Models on proxy
model LiteLLM_ProxyModelTable {
  model_id String @id @default(uuid())
  model_name String 
  litellm_params Json
  model_info Json? 
  created_at    DateTime               @default(now()) @map("created_at")
  created_by String
  updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
  updated_by String
}


// Agents on proxy
model LiteLLM_AgentsTable {
  agent_id String @id @default(uuid())
  agent_name String @unique
  litellm_params Json?
  agent_card_params Json
  static_headers       Json?          @default("{}")
  extra_headers        String[]       @default([])
  agent_access_groups String[]       @default([])
  object_permission_id String?
  object_permission LiteLLM_ObjectPermissionTable? @relation(fields: [object_permission_id], references: [object_permission_id])
  spend      Float    @default(0.0)
  tpm_limit  Int?
  rpm_limit  Int?
  session_tpm_limit Int?
  session_rpm_limit Int?
  created_at    DateTime               @default(now()) @map("created_at")
  created_by String
  updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
  updated_by String
}

model LiteLLM_OrganizationTable {
		organization_id String @id @default(uuid())
    organization_alias  String
    budget_id String
    metadata  Json  @default("{}")
    models     String[]
    spend      Float    @default(0.0)
    model_spend      Json @default("{}")
    object_permission_id String?
    created_at    DateTime               @default(now()) @map("created_at")
    created_by String
    updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
    updated_by String
    litellm_budget_table LiteLLM_BudgetTable?   @relation(fields: [budget_id], references: [budget_id])
    teams LiteLLM_TeamTable[] 
    users LiteLLM_UserTable[]
    keys LiteLLM_VerificationToken[]
    members LiteLLM_OrganizationMembership[] @relation("OrganizationToMembership")
    cavadalabs_company CavadaLabs_CompanyTable?
    object_permission LiteLLM_ObjectPermissionTable?   @relation(fields: [object_permission_id], references: [object_permission_id])
}

// Model info for teams, just has model aliases for now.
model LiteLLM_ModelTable {
  id Int @id @default(autoincrement())
  model_aliases Json? @map("aliases")
  created_at    DateTime               @default(now()) @map("created_at")
  created_by String
  updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
  updated_by String
  team LiteLLM_TeamTable?
}


// Assign prod keys to groups, not individuals 
model LiteLLM_TeamTable {
		team_id    String @id @default(uuid())
    team_alias  String? 
    organization_id String?
    object_permission_id String?
    admins String[]
    members String[]
    members_with_roles Json @default("{}")
    metadata  Json  @default("{}")
    max_budget Float?
    soft_budget Float?
    spend      Float    @default(0.0)
    models     String[]
    max_parallel_requests Int?
    tpm_limit     BigInt?
    rpm_limit     BigInt?
    budget_duration String? 
    budget_reset_at DateTime?
    blocked Boolean @default(false)
    created_at    DateTime               @default(now()) @map("created_at")
    updated_at    DateTime               @default(now()) @updatedAt @map("updated_at")
    model_spend      Json @default("{}")
    model_max_budget Json @default("{}")
    router_settings  Json? @default("{}")
    team_member_permissions String[] @default([])
    access_group_ids String[] @default([])
    policies         String[] @default([])
    default_team_member_models String[] @default([]) // default allowed_models for newly added team members; empty = no per-member restriction
    budget_limits Json? // per-model budget limits for the team
    model_id Int? @unique // id for LiteLLM_ModelTable -> stores team-level model aliases
    allow_team_guardrail_config Boolean @default(false) // if true, team admin can configure guardrails for this team
    litellm_organization_table LiteLLM_OrganizationTable?   @relation(fields: [organization_id], references: [organization_id])
    litellm_model_table LiteLLM_ModelTable? @relation(fields: [model_id], references: [id])
    object_permission LiteLLM_ObjectPermissionTable?   @relation(fields: [object_permission_id], references: [object_permission_id])
    projects LiteLLM_ProjectTable[]
    cavadalabs_project CavadaLabs_ProjectTable?

    @@index([organization_id])
    @@index([team_alias])
    @@index([created_at])
}

// Projects sit between teams and keys for use-case management
model LiteLLM_ProjectTable {
  project_id           String   @id @default(uuid())
  project_alias        String?
  description          String?
  team_id              String?
  budget_id            String?
  metadata             Json     @default("{}")
  models               String[]
  spend                Float    @default(0.0)
  model_spend          Json     @default("{}")
  model_rpm_limit      Json     @default("{}")
  model_tpm_limit      Json     @default("{}")
  blocked              Boolean  @default(false)
  object_permission_id String?
  created_at           DateTime @default(now()) @map("created_at")
  created_by           String
  updated_at           DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by           String
  
  // Relations
  litellm_team_table   LiteLLM_TeamTable?   @relation(fields: [team_id], references: [team_id])
  litellm_budget_table LiteLLM_BudgetTable? @relation(fields: [budget_id], references: [budget_id])
  keys                 LiteLLM_VerificationToken[]
  object_permission    LiteLLM_ObjectPermissionTable? @relation(fields: [object_permission_id], references: [object_permission_id])
}

model CavadaLabs_CompanyTable {
  company_id                 String   @id @default(uuid())
  legal_name                 String
  billing_name               String?
  vat_tax_id                 String?
  billing_address            Json     @default("{}")
  admin_emails               String[] @default([])
  plan                       String?
  status                     String   @default("active")
  monthly_budget             Float?
  metadata                   Json     @default("{}")
  retention_policy           Json     @default("{}")
  default_guardrail_policy   String?
  default_billing_settings   Json     @default("{}")
  litellm_organization_id    String?  @unique
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String

  projects                   CavadaLabs_ProjectTable[]
  company_members            CavadaLabs_CompanyMemberTable[]
  litellm_organization       LiteLLM_OrganizationTable? @relation(fields: [litellm_organization_id], references: [organization_id])
  chatbots                   CavadaLabs_ChatbotTable[]
  web_tokens                 CavadaLabs_WebTokenTable[]
  model_policies             CavadaLabs_ProjectModelPolicyTable[]
  model_load_requests        CavadaLabs_ModelLoadRequestTable[]
  billing_reports            CavadaLabs_BillingReportTable[]
  rag_collections            CavadaLabs_RAGCollectionTable[]
  rag_documents              CavadaLabs_RAGDocumentTable[]
  rag_assignments            CavadaLabs_ChatbotRAGAssignmentTable[]
  compliance_documents       CavadaLabs_ComplianceDocumentTable[]
  compliance_evidence        CavadaLabs_ComplianceEvidenceTable[]
  processing_activities      CavadaLabs_ProcessingActivityTable[]
  data_subject_requests      CavadaLabs_DataSubjectRequestTable[]
  ai_system_assessments      CavadaLabs_AISystemAssessmentTable[]
  guardrail_policies         CavadaLabs_GuardrailPolicyTable[]
  guardrail_decisions        CavadaLabs_GuardrailDecisionLogTable[]

  @@index([status])
  @@index([legal_name])
}

model CavadaLabs_ProjectTable {
  project_id                 String   @id @default(uuid())
  company_id                 String
  name                       String
  status                     String   @default("dev")
  allowed_models             String[] @default([])
  allowed_rag_collections    String[] @default([])
  default_chatbot_settings   Json     @default("{}")
  default_guardrail_policy   String?
  budget                     Float?
  retention_policy_override Json     @default("{}")
  metadata                   Json     @default("{}")
  litellm_team_id            String?  @unique
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  litellm_team               LiteLLM_TeamTable? @relation(fields: [litellm_team_id], references: [team_id])
  project_members            CavadaLabs_ProjectMemberTable[]
  chatbots                   CavadaLabs_ChatbotTable[]
  web_tokens                 CavadaLabs_WebTokenTable[]
  model_policies             CavadaLabs_ProjectModelPolicyTable[]
  model_load_requests        CavadaLabs_ModelLoadRequestTable[]
  gpu_locks                  CavadaLabs_GPULockTable[]
  rag_collections            CavadaLabs_RAGCollectionTable[]
  rag_documents              CavadaLabs_RAGDocumentTable[]
  rag_assignments            CavadaLabs_ChatbotRAGAssignmentTable[]
  compliance_documents       CavadaLabs_ComplianceDocumentTable[]
  compliance_evidence        CavadaLabs_ComplianceEvidenceTable[]
  processing_activities      CavadaLabs_ProcessingActivityTable[]
  data_subject_requests      CavadaLabs_DataSubjectRequestTable[]
  ai_system_assessments      CavadaLabs_AISystemAssessmentTable[]
  guardrail_policies         CavadaLabs_GuardrailPolicyTable[]
  guardrail_decisions        CavadaLabs_GuardrailDecisionLogTable[]

  @@unique([company_id, name])
  @@index([company_id, status])
}

model CavadaLabs_CompanyMemberTable {
  membership_id              String   @id @default(uuid())
  company_id                 String
  user_id                    String
  role                       String
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String?
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String?

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id], onDelete: Cascade)
  user                       LiteLLM_UserTable @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([company_id, user_id])
  @@index([company_id, role])
  @@index([user_id, role])
}

model CavadaLabs_ProjectMemberTable {
  membership_id              String   @id @default(uuid())
  project_id                 String
  user_id                    String
  role                       String
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String?
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String?

  project                    CavadaLabs_ProjectTable @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  user                       LiteLLM_UserTable @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([project_id, role])
  @@index([user_id, role])
}

model CavadaLabs_ChatbotTable {
  chatbot_id                 String   @id @default(uuid())
  company_id                 String
  project_id                 String
  name                       String
  status                     String   @default("draft")
  system_prompt              String   @default("")
  prompt_version             Int      @default(1)
  default_language           String   @default("it")
  model_policy_id            String?
  assigned_rag_collections   String[] @default([])
  assigned_guardrail_policy  String?
  allowed_domains            String[] @default([])
  widget_theme_config        Json     @default("{}")
  fallback_message           String?
  transcript_retention_policy Json    @default("{}")
  metadata                   Json     @default("{}")
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  project                    CavadaLabs_ProjectTable @relation(fields: [project_id], references: [project_id])
  web_tokens                 CavadaLabs_WebTokenTable[]
  rag_assignments            CavadaLabs_ChatbotRAGAssignmentTable[]
  compliance_documents       CavadaLabs_ComplianceDocumentTable[]
  compliance_evidence        CavadaLabs_ComplianceEvidenceTable[]
  ai_system_assessments      CavadaLabs_AISystemAssessmentTable[]
  guardrail_policies         CavadaLabs_GuardrailPolicyTable[]
  guardrail_decisions        CavadaLabs_GuardrailDecisionLogTable[]

  @@unique([project_id, name])
  @@index([company_id, project_id, status])
}

model CavadaLabs_WebTokenTable {
  web_token_id               String   @id @default(uuid())
  company_id                 String
  project_id                 String
  chatbot_id                 String
  name                       String?
  token_prefix               String
  token_hash                 String   @unique
  status                     String   @default("active")
  allowed_domains            String[] @default([])
  allowed_origins            String[] @default([])
  route_allowlist            String[] @default([])
  ip_rpm_limit               Int?
  session_rpm_limit          Int?
  session_budget             Float?
  expires_at                 DateTime
  revoked_at                 DateTime?
  last_used_at               DateTime?
  metadata                   Json     @default("{}")
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  project                    CavadaLabs_ProjectTable @relation(fields: [project_id], references: [project_id])
  chatbot                    CavadaLabs_ChatbotTable @relation(fields: [chatbot_id], references: [chatbot_id])
  guardrail_decisions        CavadaLabs_GuardrailDecisionLogTable[]

  @@index([company_id, project_id, chatbot_id])
  @@index([status, expires_at])
  @@index([token_prefix])
}

model CavadaLabs_ProjectModelPolicyTable {
  policy_id                  String   @id @default(uuid())
  company_id                 String
  project_id                 String
  endpoint_type              String   @default("chat_completion")
  model_bucket               String   @default("default")
  model_alias                String
  provider                   String
  deployment_id              String?
  priority                   Int
  enabled                    Boolean  @default(true)
  fallback_enabled           Boolean  @default(true)
  require_json_output        Boolean  @default(false)
  force_json_output          Boolean  @default(false)
  json_schema                Json?
  strict_json                Boolean  @default(false)
  repair_invalid_json        Boolean  @default(false)
  retry_on_invalid_json      Boolean  @default(false)
  require_no_think           Boolean  @default(false)
  no_think                   Boolean  @default(false)
  reasoning_mode             String?
  hide_reasoning             Boolean  @default(false)
  strip_thinking_tags        Boolean  @default(false)
  prefer_loaded_model        Boolean  @default(true)
  max_cost_input             Float?
  max_cost_output            Float?
  required_capabilities      String[] @default([])
  metadata                   Json     @default("{}")
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  project                    CavadaLabs_ProjectTable @relation(fields: [project_id], references: [project_id])

  @@unique([project_id, endpoint_type, model_bucket, priority], map: "CavadaLabs_ModelPolicy_project_endpoint_bucket_priority_key")
  @@index([company_id, project_id, endpoint_type, model_bucket, enabled, priority], map: "CavadaLabs_ModelPolicy_co_proj_endpoint_bucket_enabled_idx")
  @@index([provider, model_alias])
}

model CavadaLabs_RequestLedgerTable {
  ledger_id                  String   @id @default(uuid())
  request_id                 String   @unique
  company_id                 String
  project_id                 String
  chatbot_id                 String?
  web_token_id               String?
  session_id                 String?
  api_key_hash               String?
  provider                   String
  model                      String
  node_id                    String?
  gpu_id                     String?
  loaded_model_id            String?
  model_load_request_id      String?
  prompt_tokens              Int      @default(0)
  completion_tokens          Int      @default(0)
  total_tokens               Int      @default(0)
  spend                      Float    @default(0.0)
  status                     String
  metadata                   Json     @default("{}")
  created_at                 DateTime @default(now()) @map("created_at")

  @@index([company_id, created_at])
  @@index([project_id, created_at])
  @@index([chatbot_id, created_at])
  @@index([web_token_id, created_at])
  @@index([provider, model])
  @@index([node_id, gpu_id])
}

model CavadaLabs_AuditLogTable {
  audit_log_id               String   @id @default(uuid())
  actor_user_id              String?
  actor_api_key_hash         String?
  action                     String
  resource_type              String
  resource_id                String
  company_id                 String?
  project_id                 String?
  before_value               Json?
  after_value                Json?
  created_at                 DateTime @default(now()) @map("created_at")

  @@index([company_id, created_at])
  @@index([project_id, created_at])
  @@index([resource_type, resource_id])
  @@index([actor_user_id, created_at])
}

model CavadaLabs_BillingReportTable {
  report_id                  String   @id @default(uuid())
  company_id                 String
  report_version             Int
  period_start               DateTime
  period_end                 DateTime
  currency                   String   @default("EUR")
  status                     String   @default("generated")
  formats                    String[] @default([])
  total_requests             Int      @default(0)
  total_tokens               Int      @default(0)
  total_spend                Float    @default(0.0)
  provider_cost              Float    @default(0.0)
  cavadalabs_node_cost       Float    @default(0.0)
  tax_rate                   Float?
  tax_amount                 Float?
  grand_total                Float    @default(0.0)
  checksum                   String   @unique
  inputs_snapshot            Json     @default("{}")
  totals                     Json     @default("{}")
  breakdowns                 Json     @default("{}")
  artifacts                  Json     @default("{}")
  metadata                   Json     @default("{}")
  generated_at               DateTime @default(now())
  generated_by               String
  created_at                 DateTime @default(now()) @map("created_at")
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])

  @@unique([company_id, period_start, period_end, report_version])
  @@index([company_id, period_start, period_end])
  @@index([generated_at])
}

model CavadaLabs_GuardrailPolicyTable {
  policy_id                         String   @id @default(uuid())
  company_id                        String
  project_id                        String?
  chatbot_id                        String?
  name                              String
  version                           Int      @default(1)
  scope                             String   @default("company")
  status                            String   @default("draft")
  enforcement_mode                  String   @default("enforce")
  description                       String?
  categories                        String[] @default([])
  rules                             Json     @default("{}")
  blocked_patterns                  String[] @default([])
  redaction_patterns                Json     @default("{}")
  pii_detection_enabled             Boolean  @default(true)
  prompt_injection_detection_enabled Boolean @default(true)
  log_raw_content                   Boolean  @default(false)
  metadata                          Json     @default("{}")
  created_at                        DateTime @default(now()) @map("created_at")
  created_by                        String
  updated_at                        DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                        String

  company                           CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  project                           CavadaLabs_ProjectTable? @relation(fields: [project_id], references: [project_id])
  chatbot                           CavadaLabs_ChatbotTable? @relation(fields: [chatbot_id], references: [chatbot_id])
  decision_logs                     CavadaLabs_GuardrailDecisionLogTable[]

  @@unique([company_id, project_id, chatbot_id, name, version])
  @@index([company_id, scope, status])
  @@index([project_id, status])
  @@index([chatbot_id, status])
  @@index([name, version])
}

model CavadaLabs_GuardrailDecisionLogTable {
  decision_id           String   @id @default(uuid())
  policy_id             String?
  policy_name           String?
  company_id            String
  project_id            String?
  chatbot_id            String?
  web_token_id          String?
  session_id            String?
  request_id            String?
  phase                 String   @default("pre_call")
  decision              String
  action                String
  confidence            Float?
  reason_code           String?
  triggered_rules       Json     @default("[]")
  redaction_summary     Json     @default("{}")
  latency_ms            Int      @default(0)
  metadata              Json     @default("{}")
  created_at            DateTime @default(now()) @map("created_at")

  policy                CavadaLabs_GuardrailPolicyTable? @relation(fields: [policy_id], references: [policy_id])
  company               CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  project               CavadaLabs_ProjectTable? @relation(fields: [project_id], references: [project_id])
  chatbot               CavadaLabs_ChatbotTable? @relation(fields: [chatbot_id], references: [chatbot_id])
  web_token             CavadaLabs_WebTokenTable? @relation(fields: [web_token_id], references: [web_token_id])

  @@index([policy_id, created_at])
  @@index([company_id, created_at])
  @@index([project_id, created_at])
  @@index([chatbot_id, created_at])
  @@index([decision, created_at])
  @@index([request_id])
}

model CavadaLabs_RAGCollectionTable {
  collection_id              String   @id @default(uuid())
  company_id                 String
  project_id                 String?
  name                       String
  description                String?
  scope                      String   @default("project")
  status                     String   @default("draft")
  source_type                String?
  vector_store_provider      String?
  vector_store_id            String?
  embedding_model            String?
  chunking_strategy          Json     @default("{}")
  access_policy              Json     @default("{}")
  retention_policy           Json     @default("{}")
  metadata                   Json     @default("{}")
  created_at                 DateTime @default(now()) @map("created_at")
  created_by                 String
  updated_at                 DateTime @default(now()) @updatedAt @map("updated_at")
  updated_by                 String

  company                    CavadaLabs_CompanyTable @relation(fields: [company_id], references: [company_id])
  project                    CavadaLabs_ProjectTable? @relation(fields: [project_id], references: [project_id])
  documents                  CavadaLabs_RAGDocumentTable[]
  chatbot_assignments        CavadaLabs_ChatbotRAGAssignmentTable[]
  compliance_documents       CavadaLabs_ComplianceDocumentTable[]
  compliance_evidence        CavadaLabs_ComplianceEvidenceTable[]

  @@unique([company_id, name])
  @@index([company_id, status])
  @@index([project_id, status])
  @@index([vector_store_provider, vector_store_id])
}

model CavadaLabs_RAGDocumentTable {
  document_id                String   @id @default(uuid())
  collection_id              String
  company_id                 String
  project_id                 String?
  source_uri                 String?
  file_name                  String?
  mime_type                  String?
  status                     String   @default("queued")
  content_hash               String?
  byte_size                  Int?
  token_count                Int?
  chunk_count                Int      @default(0)
  last_indexed_at            DateTime?
  failure_reason             String?
